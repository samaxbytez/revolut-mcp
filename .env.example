# Access token from the Revolut Business API (valid for 40 minutes)
REVOLUT_ACCESS_TOKEN=your_access_token_here

# Sandbox by default. Production: https://b2b.revolut.com
REVOLUT_BASE_URL=https://sandbox-b2b.revolut.com

# Registers payments, transfers, exchanges, payout links, payment drafts, new
# payees, card changes, team invitations and webhook changes. Leave unset unless
# you mean it.
# REVOLUT_ENABLE_SENSITIVE_TOOLS=true
